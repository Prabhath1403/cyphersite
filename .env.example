# === Database ===
POSTGRES_USER=ciphersight
POSTGRES_PASSWORD=ciphersight_pass
POSTGRES_DB=ciphersight
DATABASE_URL=postgresql+asyncpg://ciphersight:ciphersight_pass@db:5432/ciphersight

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Celery ===
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# === JWT Auth ===
SECRET_KEY=change-this-to-a-strong-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === Application ===
APP_NAME=CipherSight
APP_VERSION=1.0.0
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# === Artifacts ===
ARTIFACTS_DIR=/app/artifacts
